---
/** مخططات SVG أصلية — النص العربي داخلها نص حقيقي لا صورة */
interface Props {
  kind: 'decision' | 'humantool' | 'repurpose' | 'diagnose' | 'funnel' | 'pillars' | 'delegation' | 'layers';
  caption?: string;
}
const { kind, caption } = Astro.props;

const captions: Record<Props['kind'], string> = {
  decision: 'امشِ من الأعلى وتوقّف عند أول «لا»، وعدّل الزاوية بدل أن تترك المجال',
  humantool: 'الأداة تتوسط العمل ولا تبدأه ولا تختمه',
  repurpose: 'فكرة واحدة تتحول إلى خمس قطع بصيغ مختلفة، لا إلى خمس نسخ من النص نفسه',
  diagnose: 'ابدأ من أعلى القمع: كل رقم ضعيف يشير إلى طبقة مختلفة',
  funnel: 'من محتوى يُقرأ إلى ثقة تُبنى إلى فرصة تصل',
  pillars: 'كل عمود يخدم هدفا مختلفا، والتوازن بينها يمنع أن يصير حسابك إعلانا',
  delegation: 'كلما نزلت في السلّم زادت المادة التي تعطيها، وارتفعت جودة ما يخرج منها',
  layers: 'اقرأ كل تفكيك على ثلاث طبقات، ولا تخلط التفسير بما يمكن التحقق منه',
};
const cap = caption ?? captions[kind];
---

<figure class="figure">
  {kind === 'decision' && (
    <svg viewBox="0 0 320 254" role="img" aria-label="مخطط قرار لاختيار المجال: ثلاثة أسئلة متتالية، وأي إجابة بلا تعني تعديل الزاوية">
      <title>مخطط قرار لاختيار المجال</title>
      <defs>
        <marker id="dg-a" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto">
          <path d="M0 1 L7 4.5 L0 8 z" fill="#14655F" />
        </marker>
        <marker id="dg-b" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto">
          <path d="M0 1 L7 4.5 L0 8 z" fill="#A8431E" />
        </marker>
      </defs>
      <g font-family="Readex, sans-serif" font-size="12.5" fill="#241E1A">
        <rect x="56" y="4" width="212" height="38" rx="10" fill="#DFEDEB" />
        <text x="162" y="28" text-anchor="middle">عندي خبرة حقيقية فيه؟</text>
        <line x1="162" y1="42" x2="162" y2="64" stroke="#14655F" stroke-width="1.6" marker-end="url(#dg-a)" />
        <rect x="56" y="66" width="212" height="38" rx="10" fill="#DFEDEB" />
        <text x="162" y="90" text-anchor="middle">يسأل عنه أحد فعلا؟</text>
        <line x1="162" y1="104" x2="162" y2="126" stroke="#14655F" stroke-width="1.6" marker-end="url(#dg-a)" />
        <rect x="56" y="128" width="212" height="38" rx="10" fill="#DFEDEB" />
        <text x="162" y="152" text-anchor="middle">أتكلم فيه سنة كاملة؟</text>
        <line x1="162" y1="166" x2="162" y2="188" stroke="#14655F" stroke-width="1.6" marker-end="url(#dg-a)" />
        <rect x="42" y="190" width="240" height="40" rx="12" fill="#241E1A" />
        <text x="162" y="215" text-anchor="middle" fill="#FBF6EE" font-weight="600">هذا مجالك — ابدأ منه</text>
        <path d="M56 23 H24 V246 H96" fill="none" stroke="#A8431E" stroke-width="1.4" stroke-dasharray="4 4" marker-end="url(#dg-b)" />
        <path d="M56 85 H24" fill="none" stroke="#A8431E" stroke-width="1.4" stroke-dasharray="4 4" />
        <path d="M56 147 H24" fill="none" stroke="#A8431E" stroke-width="1.4" stroke-dasharray="4 4" />
        <text x="176" y="250" text-anchor="middle" fill="#A8431E" font-size="11.5">لا — عدّل الزاوية ثم أعد السؤال</text>
      </g>
    </svg>
  )}

  {kind === 'humantool' && (
    <svg viewBox="0 0 320 208" role="img" aria-label="مخطط يوضح أن الإنسان يبدأ بالسياق والقرار، والأداة تتوسط بالمسودات، والإنسان يختم بالتحرير والنشر">
      <title>دور الإنسان ودور الأداة</title>
      <g font-family="Readex, sans-serif" font-size="12.5" fill="#241E1A">
        <rect x="8" y="14" width="94" height="180" rx="14" fill="#F7E9DA" />
        <rect x="113" y="14" width="94" height="180" rx="14" fill="#E9E4F4" />
        <rect x="218" y="14" width="94" height="180" rx="14" fill="#F7E9DA" />
        <text x="55" y="38" text-anchor="middle" font-weight="600" fill="#9B4A1E">أنت</text>
        <text x="160" y="38" text-anchor="middle" font-weight="600" fill="#574191">الأداة</text>
        <text x="265" y="38" text-anchor="middle" font-weight="600" fill="#9B4A1E">أنت</text>
        <g font-size="11.5" fill="#5E5148">
          <text x="55" y="64" text-anchor="middle">السياق</text>
          <text x="55" y="86" text-anchor="middle">الجمهور</text>
          <text x="55" y="108" text-anchor="middle">الموقف</text>
          <text x="55" y="130" text-anchor="middle">المثال</text>
          <text x="55" y="152" text-anchor="middle">الهدف</text>
          <text x="160" y="64" text-anchor="middle">مسودات</text>
          <text x="160" y="86" text-anchor="middle">صياغات</text>
          <text x="160" y="108" text-anchor="middle">اختصار</text>
          <text x="160" y="130" text-anchor="middle">ترتيب</text>
          <text x="160" y="152" text-anchor="middle">بدائل</text>
          <text x="265" y="64" text-anchor="middle">النقد</text>
          <text x="265" y="86" text-anchor="middle">التحرير</text>
          <text x="265" y="108" text-anchor="middle">التحقق</text>
          <text x="265" y="130" text-anchor="middle">الصوت</text>
          <text x="265" y="152" text-anchor="middle">النشر</text>
        </g>
        <text x="160" y="182" text-anchor="middle" font-size="11" fill="#5E5148">القرار في الطرفين، لا في الوسط</text>
      </g>
    </svg>
  )}

  {kind === 'repurpose' && (
    <svg viewBox="0 0 320 224" role="img" aria-label="فكرة واحدة تتفرع إلى منشور قصير وسلسلة وكاروسيل وفيديو قصير ونشرة">
      <title>تفرّع الفكرة الواحدة</title>
      <g font-family="Readex, sans-serif" font-size="12" fill="#241E1A">
        <rect x="96" y="6" width="128" height="40" rx="12" fill="#241E1A" />
        <text x="160" y="31" text-anchor="middle" fill="#FBF6EE" font-weight="600">فكرة واحدة</text>
        {[
          ['منشور قصير', '#E2ECF4', '#1C5C86', 62],
          ['سلسلة من 5', '#E4EEE1', '#3A6B33', 96],
          ['كاروسيل', '#FAEDD2', '#85600C', 130],
          ['فيديو قصير', '#DFEDEB', '#14655F', 164],
          ['رسالة للقناة', '#F8E3E1', '#9C3F3C', 198],
        ].map(([label, bg, ink, y]) => (
          <>
            <path d={`M160 46 V${Number(y) + 4} H196`} fill="none" stroke="#C9B8A3" stroke-width="1.4" />
            <rect x="198" y={Number(y) - 12} width="114" height="30" rx="9" fill={String(bg)} />
            <text x="255" y={Number(y) + 7} text-anchor="middle" fill={String(ink)}>{label}</text>
          </>
        ))}
        <text x="72" y="205" text-anchor="middle" font-size="11" fill="#5E5148">زاوية مختلفة</text>
        <text x="72" y="221" text-anchor="middle" font-size="11" fill="#5E5148">لكل صيغة</text>
      </g>
    </svg>
  )}

  {kind === 'diagnose' && (
    <svg viewBox="0 0 320 236" role="img" aria-label="قمع تشخيص: الوصول ثم الإكمال ثم الحفظ ثم زيارة الحساب ثم المتابعة، وكل طبقة ترتبط بسبب مختلف">
      <title>قمع تشخيص المحتوى</title>
      <g font-family="Readex, sans-serif" font-size="12" fill="#241E1A">
        {[
          ['وصول ضعيف', 'الفكرة أو التوقيت', '#F8E3E1', '#9C3F3C', 8, 300],
          ['يشاهدون ولا يكملون', 'الهوك أو الإيقاع', '#FAEDD2', '#85600C', 54, 254],
          ['يكملون ولا يحفظون', 'لا توجد نتيجة يملكونها', '#E4EEE1', '#3A6B33', 100, 208],
          ['يحفظون ولا يزورون', 'الحساب لا يشرح نفسه', '#E2ECF4', '#1C5C86', 146, 162],
          ['يزورون ولا يتابعون', 'البايو والمنشور المثبت', '#E9E4F4', '#574191', 192, 116],
        ].map(([t, why, bg, ink, y, w]) => (
          <>
            <rect x={(320 - Number(w)) / 2} y={Number(y)} width={Number(w)} height="38" rx="10" fill={String(bg)} />
            <text x="160" y={Number(y) + 17} text-anchor="middle" font-weight="600" fill={String(ink)}>{t}</text>
            <text x="160" y={Number(y) + 32} text-anchor="middle" font-size="10.5" fill="#5E5148">{why}</text>
          </>
        ))}
      </g>
    </svg>
  )}

  {kind === 'funnel' && (
    <svg viewBox="0 0 320 132" role="img" aria-label="من محتوى يُقرأ إلى ثقة تُبنى إلى فرصة تصل">
      <title>من المحتوى إلى الفرصة</title>
      <g font-family="Readex, sans-serif" font-size="12.5" fill="#241E1A">
        {[
          ['محتوى يُقرأ', '#E2ECF4', '#1C5C86', 8],
          ['ثقة تُبنى', '#E4EEE1', '#3A6B33', 114],
          ['فرصة تصل', '#F7E9DA', '#9B4A1E', 220],
        ].map(([t, bg, ink, x]) => (
          <>
            <rect x={Number(x)} y="30" width="92" height="52" rx="12" fill={String(bg)} />
            <text x={Number(x) + 46} y="61" text-anchor="middle" font-weight="600" fill={String(ink)}>{t}</text>
          </>
        ))}
        <path d="M108 56 H110 M100 56 H110" stroke="#C9B8A3" stroke-width="1.6" />
        <path d="M100 56 H112" stroke="#C9B8A3" stroke-width="1.6" />
        <path d="M206 56 H218" stroke="#C9B8A3" stroke-width="1.6" />
        <text x="160" y="106" text-anchor="middle" font-size="11" fill="#5E5148">لا تقفز من اليمين إلى اليسار مباشرة</text>
      </g>
    </svg>
  )}

  {kind === 'pillars' && (
    <svg viewBox="0 0 320 178" role="img" aria-label="أربعة أعمدة محتوى: نمو وثقة وتحويل ومجتمع، وكل عمود له هدف مختلف">
      <title>أعمدة المحتوى وأهدافها</title>
      <g font-family="Readex, sans-serif" font-size="12" fill="#241E1A">
        {[
          ['نمو', 'يصل إلى غريب', '#FAEDD2', '#85600C', 8, 96],
          ['ثقة', 'يثبت أنك تعرف', '#E4EEE1', '#3A6B33', 84, 118],
          ['تحويل', 'يقول ماذا تقدم', '#E2ECF4', '#1C5C86', 160, 76],
          ['مجتمع', 'يجعلهم يردون', '#F8E3E1', '#9C3F3C', 236, 60],
        ].map(([t, d, bg, ink, x, h]) => (
          <>
            <rect x={Number(x)} y={148 - Number(h)} width="76" height={Number(h)} rx="10" fill={String(bg)} />
            <text x={Number(x) + 38} y={148 - Number(h) + 24} text-anchor="middle" font-weight="600" fill={String(ink)}>{t}</text>
            <text x={Number(x) + 38} y={168} text-anchor="middle" font-size="10.5" fill="#5E5148">{d}</text>
          </>
        ))}
        <line x1="4" y1="149" x2="316" y2="149" stroke="#E2D6C6" stroke-width="1.4" />
      </g>
    </svg>
  )}

  {kind === 'delegation' && (
    <svg viewBox="0 0 320 200" role="img" aria-label="سلّم التفويض بأربع درجات: التنقيح ثم التحويل ثم توليد البدائل ثم الابتكار من فراغ، وجودة المخرج ترتفع كلما زادت المادة التي تعطيها">
      <title>سلّم التفويض للأداة</title>
      <g font-family="Readex, sans-serif" font-size="12" fill="#241E1A">
        {[
          ['تنقيح', 'مأمون', '#E4EEE1', '#3A6B33', 0],
          ['تحويل', 'عالٍ', '#DFEDEB', '#14655F', 1],
          ['توليد بدائل', 'جيد', '#FAEDD2', '#85600C', 2],
          ['ابتكار من فراغ', 'ضعيف', '#F8E3E1', '#9C3F3C', 3],
        ].map(([t, q, bg, ink, i]) => (
          <>
            <rect x={12 + Number(i) * 8} y={8 + Number(i) * 46} width={284 - Number(i) * 16} height="38" rx="9" fill={String(bg)} />
            <text x={26 + Number(i) * 8} y={32 + Number(i) * 46} font-weight="600" fill={String(ink)}>{t}</text>
            <text x={284 - Number(i) * 8} y={32 + Number(i) * 46} text-anchor="end" font-size="11" fill="#5E5148">{q}</text>
          </>
        ))}
        <text x="160" y="196" text-anchor="middle" font-size="10.5" fill="#5E5148">كلما نزلت زادت المادة التي تعطيها، وارتفعت جودة المخرج</text>
      </g>
    </svg>
  )}

  {kind === 'layers' && (
    <svg viewBox="0 0 320 168" role="img" aria-label="ثلاث طبقات لقراءة أي تفكيك: ما يمكن التحقق منه ثم القراءة ثم المبدأ القابل للنقل">
      <title>طبقات قراءة التفكيك</title>
      {/* الاتجاه عربي: الخط الجانبي على اليمين كما في مكوّن Layer، والنص يبدأ منه */}
      <g font-family="Readex, sans-serif" font-size="12" fill="#241E1A">
        <rect x="10" y="8" width="300" height="42" rx="9" fill="#E2ECF4" />
        <rect x="305" y="8" width="5" height="42" fill="#1C5C86" />
        <text x="292" y="27" font-weight="600" fill="#1C5C86">ما يمكن التحقق منه</text>
        <text x="292" y="43" font-size="10.5" fill="#5E5148">ما تعلنه المنصة أو نمط ظاهر</text>

        <rect x="10" y="60" width="300" height="42" rx="9" fill="none" stroke="#C9B8A3" stroke-width="1.5" stroke-dasharray="5 4" />
        <text x="292" y="79" font-weight="600" fill="#5E5148">قراءتنا</text>
        <text x="292" y="95" font-size="10.5" fill="#5E5148">تفسير قد يكون خاطئا</text>

        <path d="M310 121 H28 L10 139 V154 H310 Z" fill="#EDE6F3" />
        <text x="292" y="139" font-weight="600" fill="#5B4A80">المبدأ الذي ينتقل إليك</text>
        <text x="292" y="152" font-size="10.5" fill="#5E5148">يبقى صالحا لو تغيّر المثال كله</text>
      </g>
    </svg>
  )}

  <figcaption>{cap}</figcaption>
</figure>

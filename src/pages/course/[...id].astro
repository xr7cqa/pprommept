---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import * as C from '../../components/content';
import { stageByN } from '../../lib/stages';
import { routes } from '../../lib/url';

export async function getStaticPaths() {
  const lessons = (await getCollection('course')).sort(
    (a, b) => a.data.stage - b.data.stage || a.data.order - b.data.order,
  );
  return lessons.map((entry, i) => ({
    params: { id: entry.id },
    props: {
      entry,
      prev: i > 0 ? lessons[i - 1] : null,
      next: i < lessons.length - 1 ? lessons[i + 1] : null,
      index: i,
      total: lessons.length,
      siblings: lessons.filter((l) => l.data.stage === entry.data.stage),
    },
  }));
}

const { entry, prev, next, siblings } = Astro.props;
const d = entry.data;
const st = stageByN(d.stage);
const { Content, headings } = await render(entry);
const posInStage = siblings.findIndex((l) => l.id === entry.id) + 1;

/** أقسام الدرس الرئيسية تصنع قائمة المحتويات */
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={d.title} description={d.summary} bodyClass="has-bottom-bar">
  <div class="read-bar" aria-hidden="true"><i data-read-bar></i></div>

  <div
    data-lesson-page
    data-lesson-id={entry.id}
    data-lesson-title={d.title}
    data-lesson-stage={String(d.stage)}
  >
    <div class="lesson-hero" style={`background:var(--${st.tone}-bg)`}>
      <div class="wrap">
        <nav aria-label="مسار التنقل">
          <ol class="crumbs" style={`color:var(--${st.tone}-ink)`}>
            <li><a href={routes.dashboard()}>لوحتك</a></li>
            <li><a href={routes.map()}>خريطة المسار</a></li>
            <li><a href={`${routes.map()}#stage-${st.slug}`}>{st.title}</a></li>
            <li><span aria-current="page">الدرس {posInStage} من {siblings.length}</span></li>
          </ol>
        </nav>
        <h1>{d.title}</h1>
        <p class="facts">
          <span>{d.minutes} دقائق قراءة وتطبيق</span>
          <span>{d.core ? 'درس أساسي' : 'درس اختياري'}</span>
          <span>المرحلة {d.stage} من 7</span>
        </p>
        <div class="rail" style="margin-top:var(--sp-4);max-width:22rem" aria-hidden="true">
          {siblings.map((_, i) => <i class={i < posInStage ? 'on' : ''} />)}
        </div>
      </div>
    </div>

    <div class="wrap">
      <div class="lesson-layout">
        {toc.length > 1 && (
          <nav class="lesson-toc" id="lesson-toc" aria-label="محتويات الدرس">
            <button
              class="toc-toggle" type="button"
              aria-expanded="false" aria-controls="toc-list"
            >محتويات الدرس ({toc.length} أقسام)</button>
            <ul class="toc-list" id="toc-list">
              {toc.map((h) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ul>
          </nav>
        )}

        <article class="lesson-body">
          <div class="box-result">
            <p class="box-h">ما ستملكه بعد هذا الدرس</p>
            <p style="margin:0;font-family:var(--f-ui);font-size:var(--t-base);line-height:1.7">{d.outcome}</p>
          </div>

          <Content components={C} />

          <div class="box-apply" style="margin-top:var(--sp-7)">
            <p class="box-h">الخطوة التالية</p>
            <p style="margin-bottom:0">{d.nextStep}</p>
          </div>

          <div class="btn-row" style="margin-top:var(--sp-6)" data-needs-storage>
            <button class="btn" type="button" data-complete aria-pressed="false">
              <Icon name="check" size={18} />
              <span data-complete-label>أنجزت هذا الدرس</span>
            </button>
            <button class="btn btn--quiet" type="button" data-save aria-pressed="false">
              <Icon name="bookmark" size={18} />
              <span data-save-label>احفظ الدرس</span>
            </button>
          </div>

          <p class="small muted" style="margin-top:var(--sp-4)" data-needs-storage>
            الزر يعمل في الاتجاهين: اضغطه مرة ليُسجَّل الدرس منجزا، ومرة أخرى لتتراجع
          </p>

          <p class="small muted" style="margin-top:var(--sp-4)" data-storage-warning hidden>
            متصفحك يمنع الحفظ المحلي، لذلك لن يُحفظ تقدمك. المحتوى والتنقل يعملان كالمعتاد
          </p>

          <nav class="prevnext" aria-label="التنقل بين الدروس">
            {prev ? (
              <a href={routes.lesson(prev.id)} rel="prev">
                <span class="l">الدرس السابق</span>
                <span class="t">{prev.data.title}</span>
              </a>
            ) : (
              <a href={routes.map()}>
                <span class="l">البداية</span>
                <span class="t">خريطة المسار</span>
              </a>
            )}
            {next ? (
              <a href={routes.lesson(next.id)} rel="next" class="next">
                <span class="l">الدرس التالي</span>
                <span class="t">{next.data.title}</span>
              </a>
            ) : (
              <a href={routes.finish()} class="next">
                <span class="l">وصلت إلى النهاية</span>
                <span class="t">صفحة الإتمام</span>
              </a>
            )}
          </nav>
        </article>

        <aside class="lesson-aside" aria-label="دروس هذه المرحلة">
          <div class="drawer-stage" style={`background:var(--${st.tone}-bg)`}>
            <p class="h" style={`color:var(--${st.tone}-ink)`}>{st.title}</p>
            <ol>
              {siblings.map((l, i) => (
                <li>
                  <a
                    href={routes.lesson(l.id)}
                    data-lesson-id={l.id}
                    aria-current={l.id === entry.id ? 'page' : undefined}
                  >
                    <span class="num">{d.stage}.{i + 1}</span>
                    <span>{l.data.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
          <p style="margin-top:var(--sp-4)">
            <a class="btn btn--quiet btn--sm btn--full" href={`${routes.map()}#stage-${st.slug}`}>
              عد إلى المرحلة
            </a>
          </p>
          <p>
            <a class="btn btn--quiet btn--sm btn--full" href={routes.glossary()}>قاموس المصطلحات</a>
          </p>
        </aside>
      </div>
    </div>

    {toc.length > 1 && (
      <button class="toc-fab" type="button" data-toc-fab>
        <Icon name="menu" size={18} />
        <span>المحتويات</span>
      </button>
    )}

    <nav class="bottom-bar" aria-label="تنقل الدرس">
      {prev ? (
        <a href={routes.lesson(prev.id)} rel="prev">
          <Icon name="prev" size={18} />
          <span>السابق</span>
        </a>
      ) : (
        <a href={`${routes.map()}#stage-${st.slug}`}><Icon name="map" size={18} /><span>المرحلة</span></a>
      )}
      <button class="main" type="button" data-complete aria-pressed="false">
        <Icon name="check" size={18} />
        <span data-complete-label>أنجزت الدرس</span>
      </button>
      {next ? (
        <a href={routes.lesson(next.id)} rel="next">
          <span>التالي</span>
          <Icon name="next" size={18} />
        </a>
      ) : (
        <a href={routes.finish()}><span>الإتمام</span><Icon name="next" size={18} /></a>
      )}
    </nav>
  </div>
</Base>

<script>
  import { read, update, storageAvailable } from '../../lib/progress';

  const page = document.querySelector<HTMLElement>('[data-lesson-page]');
  if (page) {
    const id = page.dataset.lessonId!;
    const completeBtns = document.querySelectorAll<HTMLButtonElement>('[data-complete]');
    const saveBtns = document.querySelectorAll<HTMLButtonElement>('[data-save]');

    /* ── الإنجاز والحفظ، ويعملان في الاتجاهين ── */
    function paint() {
      const s = read();
      const done = Boolean(s.done[id]);
      const saved = Boolean(s.saved[id]);
      completeBtns.forEach((b) => {
        b.setAttribute('aria-pressed', String(done));
        const l = b.querySelector<HTMLElement>('[data-complete-label]');
        if (l) {
          l.textContent = done
            ? 'أنجزته — اضغط للتراجع'
            : b.classList.contains('main')
              ? 'أنجزت الدرس'
              : 'أنجزت هذا الدرس';
        }
      });
      saveBtns.forEach((b) => {
        b.setAttribute('aria-pressed', String(saved));
        const l = b.querySelector<HTMLElement>('[data-save-label]');
        if (l) l.textContent = saved ? 'محفوظ — اضغط للإلغاء' : 'احفظ الدرس';
      });
    }

    completeBtns.forEach((b) =>
      b.addEventListener('click', () => {
        update((s) => {
          if (s.done[id]) delete s.done[id];
          else s.done[id] = Date.now();
        });
        paint();
      }),
    );

    saveBtns.forEach((b) =>
      b.addEventListener('click', () => {
        update((s) => {
          if (s.saved[id]) delete s.saved[id];
          else s.saved[id] = Date.now();
        });
        paint();
      }),
    );

    paint();

    /* ── شريط تقدم القراءة ── */
    const bar = document.querySelector<HTMLElement>('[data-read-bar]');
    const article = document.querySelector<HTMLElement>('.lesson-body');
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-list a'));
    const sections = tocLinks
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((el): el is HTMLElement => Boolean(el));

    let ticking = false;
    let lastSaved = 0;

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;

        if (bar && article) {
          const start = article.offsetTop;
          const span = Math.max(1, article.offsetHeight - window.innerHeight * 0.5);
          const p = Math.min(1, Math.max(0, (window.scrollY - start) / span));
          bar.style.inlineSize = `${Math.round(p * 100)}%`;
        }

        /* القسم الحالي يُميَّز في قائمة المحتويات */
        if (sections.length) {
          const line = window.scrollY + 120;
          let active = 0;
          for (let i = 0; i < sections.length; i += 1) {
            if (sections[i]!.offsetTop <= line) active = i;
          }
          tocLinks.forEach((a, i) => {
            if (i === active) a.setAttribute('aria-current', 'true');
            else a.removeAttribute('aria-current');
          });
        }

        /* موضع القراءة يُحفظ بتباعد حتى لا نثقل التخزين */
        const now = Date.now();
        if (storageAvailable() && now - lastSaved > 1500) {
          lastSaved = now;
          const y = Math.round(window.scrollY);
          update((s) => {
            if (y > 320) s.pos[id] = y;
            else delete s.pos[id];
          });
        }

        /* زر المحتويات العائم يظهر بعد مغادرة الترويسة */
        const fab = document.querySelector<HTMLElement>('[data-toc-fab]');
        if (fab) fab.dataset.visible = window.scrollY > 600 ? '1' : '0';
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    /* ── استئناف القراءة من الموضع المحفوظ، باختيار المتعلم لا قسرا ── */
    const savedY = read().pos[id] ?? 0;
    if (savedY > 320 && window.scrollY < 40) {
      const chip = document.createElement('div');
      chip.className = 'resume-chip';
      chip.innerHTML =
        '<span>تابع القراءة من حيث توقفت</span>' +
        '<span style="display:flex;gap:8px"><button type="button" data-resume-go>انتقل</button>' +
        '<button type="button" class="close" data-resume-close aria-label="إخفاء">✕</button></span>';
      document.body.appendChild(chip);
      const hide = () => chip.remove();
      chip.querySelector('[data-resume-go]')?.addEventListener('click', () => {
        window.scrollTo({ top: savedY, behavior: 'smooth' });
        hide();
      });
      chip.querySelector('[data-resume-close]')?.addEventListener('click', hide);
      window.setTimeout(hide, 9000);
    }

    /* ── قائمة المحتويات ──
       مطوية على الهاتف ومفتوحة دائما على سطح المكتب، والحالة تُحسم بالـCSS قبل أول رسم */
    const toc = document.getElementById('lesson-toc');
    const toggle = toc?.querySelector<HTMLButtonElement>('.toc-toggle');
    const narrow = () => window.matchMedia('(max-width: 63.99rem)').matches;
    const setOpen = (open: boolean) => {
      if (!toc || !toggle) return;
      toc.dataset.open = open ? '1' : '0';
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

    const fab = document.querySelector<HTMLButtonElement>('[data-toc-fab]');
    fab?.addEventListener('click', () => {
      setOpen(true);
      toc?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    /* اختيار قسم يغلق القائمة على الهاتف حتى لا تحبس المستخدم */
    tocLinks.forEach((a) =>
      a.addEventListener('click', () => {
        if (narrow()) setOpen(false);
      }),
    );
  }
</script>

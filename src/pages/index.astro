---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SupportCard from '../components/SupportCard.astro';
import { STAGES } from '../lib/stages';
import { routes } from '../lib/url';

const lessons = (await getCollection('course')).sort(
  (a, b) => a.data.stage - b.data.stage || a.data.order - b.data.order,
);
const first = lessons[0];
const coreCount = lessons.filter((l) => l.data.core).length;
const platforms = await getCollection('platforms');
const prompts = await getCollection('prompts');
const apps = await getCollection('apps');
const cases = await getCollection('cases');

/** جدول خفيف يقرأه المتصفح لتحديث نسب المسارات وبطاقة المتابعة */
const stageTable = STAGES.map((st) => ({
  n: st.n,
  core: lessons.filter((l) => l.data.stage === st.n && l.data.core).map((l) => l.id),
  all: lessons.filter((l) => l.data.stage === st.n).map((l) => ({ id: l.id, h: routes.lesson(l.id) })),
}));
const coreIds = lessons.filter((l) => l.data.core).map((l) => l.id);
const firstHref = first ? routes.lesson(first.id) : routes.map();

const outputs = [
  ['مجال يمكن خدمته', 'لا «مجال واسع» ولا مجال ضيق إلى درجة تخنقك'],
  ['وثيقة جمهور', 'مشكلته ولغته واعتراضاته مكتوبة أمامك'],
  ['حساب مجهز', 'الاسم واليوزر والصورة والبايو والمنشور المثبت'],
  ['أعمدة محتوى', 'ثلاثة إلى خمسة أعمدة مكتوبة على مجالك أنت'],
  ['بنك أفكار', 'أفكار مصنّفة بالعمود والمنصة والجهد'],
  ['نظام ذكاء اصطناعي', 'سياق ثابت تعطيه للأداة، وطريقة نقد تحفظ صوتك'],
  ['أول 15 قطعة', 'جاهزة أو شبه جاهزة للنشر'],
  ['لوحة قياس', 'تخبرك متى تعدّل ومتى توقف ومتى تضاعف'],
];
---

<Base
  title="الرئيسية"
  description="كورس عربي تفاعلي يحوّل خبرتك أو مشروعك إلى نظام محتوى: مجال واضح، وحساب مجهز، وأول 15 قطعة جاهزة للنشر"
>
  <section class="page-hero" style="background:linear-gradient(180deg,var(--s1-bg),var(--paper))">
    <div class="wrap">
      <p class="eyebrow">كورس تطبيقي · سبع مراحل</p>
      <h1>
        عندك خبرة،<br />
        وما تعرف <span style="color:var(--acc)">وش تنشر</span>
      </h1>
      <p class="lead">
        تدخل ومعك مهنة أو مشروع أو معرفة تراها عادية، وتخرج بنظام محتوى مكتوب على مجالك أنت،
        وحساب مجهز من الاسم إلى المنشور المثبت، وأول خمس عشرة قطعة جاهزة للنشر
      </p>
      <div class="btn-row" style="margin-top:var(--sp-6);max-width:30rem">
        <a class="btn" href={firstHref} id="start-btn">ابدأ الكورس</a>
        <a class="btn btn--ghost" href={routes.map()}>شاهد خريطة الكورس</a>
      </div>

      <div class="entry-card" id="entry-card" hidden>
        <div class="entry-ring" aria-hidden="true">
          <svg viewBox="0 0 44 44" width="64" height="64">
            <circle cx="22" cy="22" r="19" fill="none" stroke="var(--line)" stroke-width="5" />
            <circle
              id="ring-arc" cx="22" cy="22" r="19" fill="none"
              stroke="var(--acc)" stroke-width="5" stroke-linecap="round"
              stroke-dasharray="119.4" stroke-dashoffset="119.4"
              transform="rotate(-90 22 22)"
            />
          </svg>
          <span class="entry-ring-pct num" id="ring-pct">0%</span>
        </div>
        <div style="flex:1;min-inline-size:0">
          <p class="eyebrow" style="margin-bottom:2px" id="entry-kicker">تابع من حيث توقفت</p>
          <p class="entry-title" id="entry-title"></p>
          <p class="small muted" style="margin:0" id="entry-meta"></p>
        </div>
        <a class="btn btn--sm" href={firstHref} id="entry-btn">أكمل</a>
      </div>
    </div>
  </section>

  <section class="wrap" style="margin-top:var(--sp-7)">
    <h2>سبع مراحل، وكل مرحلة تنتهي بشيء تملكه</h2>
    <p class="muted" style="max-width:34rem">
      الترتيب موصى به لأن كل مرحلة تحتاج ما قبلها، لكنه غير مقفل. تستطيع فتح أي درس متى شئت
    </p>
    <div style="display:grid;gap:var(--sp-2);margin-top:var(--sp-5)">
      {
        STAGES.map((st) => {
          const n = lessons.filter((l) => l.data.stage === st.n).length;
          const target = lessons.find((l) => l.data.stage === st.n);
          return (
            <a
              class="stage-card"
              style={`background:var(--${st.tone}-bg)`}
              href={target ? routes.lesson(target.id) : routes.map()}
              data-stage={String(st.n)}
            >
              <span class="n" style={`color:var(--${st.tone}-ink)`}>{st.n}</span>
              <span style="flex:1;min-inline-size:0">
                <span class="t">{st.title}</span>
                <span class="d" style="display:block">{st.promise}</span>
                <span class="meta">
                  <span class="num">{n}</span> دروس ·{' '}
                  <span data-stage-outcome style={`color:var(--${st.tone}-ink)`}>{st.outcome}</span>
                </span>
                <span class="progress" data-needs-storage hidden style="margin-top:8px;max-width:16rem">
                  <i data-stage-bar style="width:0%"></i>
                </span>
              </span>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="wrap" style="margin-top:var(--sp-8)">
    <h2>ما الذي ستملكه فعلا</h2>
    <p class="muted" style="max-width:34rem">
      ليست معلومات تقرأها وتنساها. كل مرحلة تنتهي بملف أو قرار أو قطعة محتوى تخرج بها
    </p>
    <div class="grid grid-2" style="margin-top:var(--sp-5)">
      {
        outputs.map(([t, d]) => (
          <div style="background:rgba(255,255,255,.55);border-radius:var(--r-md);padding:var(--sp-4);box-shadow:inset 0 0 0 1px var(--line-soft)">
            <p style="font-family:var(--f-ui);font-weight:600;margin-bottom:2px">{t}</p>
            <p class="small muted" style="margin:0">{d}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap" style="margin-top:var(--sp-8)">
    <h2>من أين تبدأ أنت</h2>
    <div class="grid grid-2" style="margin-top:var(--sp-5)">
      <div class="box-example" style="margin:0">
        <p class="box-h">لم تنشر من قبل</p>
        <p>
          ابدأ من الدرس الأول وامشِ بالترتيب. المراحل الثلاث الأولى تبني الأساس الذي يجعل
          كل ما بعده أسهل، ولا تحتاج فيها إلى حساب جاهز ولا إلى معدات
        </p>
        {first && <a class="btn btn--sm" href={routes.lesson(first.id)}>ابدأ من البداية</a>}
      </div>
      <div class="box-apply" style="margin:0">
        <p class="box-h">تنشر منذ فترة وتشعر أن النتيجة متذبذبة</p>
        <p>
          افتح خريطة المسار واقرأ مخرج كل مرحلة. إن كان المخرج موجودا عندك مكتوبا فتجاوزها،
          وإن كان في رأسك فقط فمرّ عليها. أغلب من ينشر بلا نتيجة تنقصه المرحلة الثالثة
        </p>
        <a class="btn btn--sm btn--quiet" href={routes.map()}>افتح الخريطة</a>
      </div>
    </div>
  </section>

  <section class="wrap" style="margin-top:var(--sp-8)">
    <h2>ومعك ثلاث مكتبات مفتوحة طول الوقت</h2>
    <div class="grid grid-3" style="margin-top:var(--sp-5)">
      <a class="stage-card" style="background:var(--s6-bg)" href={routes.platforms()}>
        <span class="n" style="color:var(--s6-ink)"><Icon name="grid" size={26} /></span>
        <span>
          <span class="t">مكتبة المنصات</span>
          <span class="d" style="display:block">منطق {platforms.length} منصات وكيف تتغير الفكرة عند النقل</span>
        </span>
      </a>
      <a class="stage-card" style="background:var(--s4-bg)" href={routes.prompts()}>
        <span class="n" style="color:var(--s4-ink)"><Icon name="copy" size={26} /></span>
        <span>
          <span class="t">مكتبة البرومبتات</span>
          <span class="d" style="display:block">{prompts.length} برومبتا مكتوبا لمهمة ومنصة محددة</span>
        </span>
      </a>
      <a class="stage-card" style="background:var(--s3-bg)" href={routes.apps()}>
        <span class="n" style="color:var(--s3-ink)"><Icon name="check" size={26} /></span>
        <span>
          <span class="t">القوالب والتطبيقات</span>
          <span class="d" style="display:block">{apps.length} قوالب تملؤها فتخرج بمخرج حقيقي</span>
        </span>
      </a>
      <a class="stage-card" style="background:var(--s7-bg)" href={routes.cases()}>
        <span class="n" style="color:var(--s7-ink)"><Icon name="grid" size={26} /></span>
        <span>
          <span class="t">دراسات الحالة</span>
          <span class="d" style="display:block">{cases.length} حالة مفصولة إلى موثق وتفسير ومبدأ</span>
        </span>
      </a>
    </div>
  </section>

  <section class="wrap">
    <div class="box-note" style="margin-top:var(--sp-8)">
      <p class="box-h">قبل أن تبدأ</p>
      <p>
        المطلوب منك التطبيق لا الحفظ. كل درس ينتهي بشيء تكتبه أو تقرره، وإن مررت على الدروس
        قراءة فقط فستخرج بمعلومات لا بنظام. قلة الخبرة ليست مانعا، لكن الأداة لن تبني لك
        هوية إن لم تعطها سياقا — وهذا بالضبط ما سنتدرب عليه
      </p>
      <p style="margin-bottom:0">
        تقدمك يُحفظ داخل متصفحك وحده، فتستطيع إغلاق الصفحة والعودة إلى آخر درس متى شئت.
        عدد {coreCount} درسا أساسيا يدخل في حساب التقدم، والمكتبات المرجعية مفتوحة بلا شرط
      </p>
    </div>

    <SupportCard
      heading="إذا تعطلت في التطبيق"
      text="لسنا خدمة رد فوري، لكننا نقرأ الأسئلة ونرد عليها. أخبرنا بمجالك، وما الذي طبّقته، وأين توقفت بالضبط"
    />
  </section>
</Base>

<script define:vars={{ stageTable, coreIds, firstHref }}>
  window.__home = { stageTable, coreIds, firstHref };
</script>

<script>
  import { storageAvailable, read, ratio } from '../lib/progress';

  interface StageRow { n: number; core: string[]; all: { id: string; h: string }[] }
  const H = (window as unknown as {
    __home: { stageTable: StageRow[]; coreIds: string[]; firstHref: string };
  }).__home;

  const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  if (storageAvailable()) {
    const s = read();
    const doneCount = H.coreIds.filter((id) => s.done[id]).length;
    const pct = Math.round(ratio(s.done, H.coreIds) * 100);
    const started = doneCount > 0 || Boolean(s.last);

    document.querySelectorAll<HTMLElement>('[data-needs-storage]').forEach((el) => (el.hidden = false));

    /* بطاقة الدخول: تتحول بين البداية والمتابعة بحسب حالة المتعلم */
    const card = document.getElementById('entry-card');
    if (card && started) {
      card.hidden = false;
      const arc = document.getElementById('ring-arc');
      const C = 2 * Math.PI * 19;
      if (arc) arc.setAttribute('stroke-dashoffset', String(C * (1 - pct / 100)));
      const pctEl = document.getElementById('ring-pct');
      if (pctEl) pctEl.textContent = `${pct}%`;

      const nextRow = H.stageTable.flatMap((st) => st.all).find((l) => !s.done[l.id]);
      const target = s.last?.href ?? nextRow?.h ?? H.firstHref;
      const title = s.last?.title ?? 'ابدأ من الدرس الأول';

      const kicker = document.getElementById('entry-kicker');
      const t = document.getElementById('entry-title');
      const meta = document.getElementById('entry-meta');
      const btn = document.getElementById('entry-btn') as HTMLAnchorElement | null;
      if (kicker) kicker.textContent = s.last ? 'أكمل من حيث توقفت' : 'ابدأ من الدرس الأول';
      if (t) t.textContent = title;
      if (meta) {
        meta.innerHTML =
          `أنجزت <span class="num">${doneCount}</span> من <span class="num">${H.coreIds.length}</span> درسا أساسيا`;
      }
      if (btn) {
        btn.href = target;
        btn.textContent = s.last ? 'أكمل الدرس' : 'ابدأ';
      }

      const start = document.getElementById('start-btn') as HTMLAnchorElement | null;
      if (start && s.last) {
        start.href = target;
        start.textContent = 'أكمل من حيث توقفت';
      }
    }

    /* نسبة كل مسار تُحدَّث في مكانها بلا إعادة بناء البطاقة */
    document.querySelectorAll<HTMLAnchorElement>('a[data-stage]').forEach((el) => {
      const row = H.stageTable.find((x) => x.n === Number(el.dataset.stage));
      if (!row) return;
      const dn = row.core.filter((id) => s.done[id]).length;
      const p = row.core.length ? Math.round((dn / row.core.length) * 100) : 0;
      const bar = el.querySelector<HTMLElement>('[data-stage-bar]');
      if (bar) bar.style.width = `${p}%`;
      const out = el.querySelector<HTMLElement>('[data-stage-outcome]');
      if (out && dn > 0) out.innerHTML = `أنجزت <span class="num">${dn}</span> من <span class="num">${row.core.length}</span>`;
      const nextL = row.all.find((l) => !s.done[l.id]);
      if (nextL) el.href = nextL.h;
      void esc;
    });
  }
</script>

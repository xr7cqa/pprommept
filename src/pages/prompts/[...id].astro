---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PromptBlock from '../../components/content/PromptBlock.astro';
import * as C from '../../components/content';
import { routes } from '../../lib/url';
import { extractVariables } from '../../lib/placeholders';

export async function getStaticPaths() {
  const items = (await getCollection('prompts')).sort((a, b) => a.data.order - b.data.order);
  return items.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: i > 0 ? items[i - 1] : null, next: items[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const lessons = await getCollection('course');
const concept = d.concept ? lessons.find((l) => l.id === d.concept) : undefined;
const detected = extractVariables(entry.body ?? '');
const vars = d.variables.length ? d.variables : detected;
---

<Base title={d.title} description={d.when}>
  <div class="page-hero" style="background:var(--s4-bg)">
    <div class="wrap">
      <p class="eyebrow" style="color:var(--s4-ink)">
        <a href={routes.prompts()} style="color:var(--s4-ink);text-decoration:none">مكتبة البرومبتات</a>
      </p>
      <h1>{d.title}</h1>
      <p class="lead">{d.when}</p>
      <p style="display:flex;gap:var(--sp-2);flex-wrap:wrap;margin-top:var(--sp-4)">
        <span class="chip">{d.platform}</span>
        <span class="chip">{d.task}</span>
      </p>
    </div>
  </div>

  <div class="wrap" style="margin-top:var(--sp-6)">
    <article class="lesson-body">
      <h2 style="margin-top:0">المتغيرات التي تملؤها</h2>
      <ul>
        {vars.map((v) => <li><span class="ph">{v}</span></li>)}
      </ul>

      <PromptBlock
        id="the-prompt"
        title={d.title}
        body={entry.body ?? ''}
        conceptHref={concept ? routes.lesson(concept.id) : undefined}
        conceptLabel={concept ? 'اقرأ الدرس المرتبط' : undefined}
        quality={d.quality}
      />

      <div class="btn-row" data-needs-storage>
        <button class="btn btn--sm btn--quiet" type="button" data-fav aria-pressed="false">
          <Icon name="star" size={17} />
          <span data-fav-label>أضف إلى المفضلة</span>
        </button>
      </div>

      <h2>مثال إدخال</h2>
      <div class="box-example" style="margin-top:var(--sp-3)">
        <p class="box-h">لو كنت أنا صاحب المشروع</p>
        <p style="margin-bottom:0;white-space:pre-line">{d.exampleInput}</p>
      </div>

      <h2>نموذج نتيجة</h2>
      <div class="box-apply" style="margin-top:var(--sp-3)">
        <p class="box-h">هكذا تبدو نتيجة مقبولة</p>
        <p style="margin-bottom:0;white-space:pre-line">{d.exampleOutput}</p>
      </div>

      <div class="box-warn">
        <p class="box-h">لا تنشر المخرج كما هو</p>
        <p style="margin-bottom:0">
          هذا النموذج مسودة جيدة لا نصا نهائيا. أعد كتابته بصوتك، واحذف أي جملة لا تشبهك،
          وأضف تفصيلة من تجربتك لا تعرفها الأداة
        </p>
      </div>

      <Content components={C} />

      <nav class="prevnext" aria-label="التنقل بين البرومبتات">
        {prev ? (
          <a href={routes.prompt(prev.id)} rel="prev"><span class="l">السابق</span><span class="t">{prev.data.title}</span></a>
        ) : (
          <a href={routes.prompts()}><span class="l">عودة</span><span class="t">مكتبة البرومبتات</span></a>
        )}
        {next ? (
          <a href={routes.prompt(next.id)} rel="next" class="next"><span class="l">التالي</span><span class="t">{next.data.title}</span></a>
        ) : (
          <a href={routes.prompts()} class="next"><span class="l">عودة</span><span class="t">مكتبة البرومبتات</span></a>
        )}
      </nav>

      <p style="margin-top:var(--sp-6)">
        <a class="btn btn--quiet" href={routes.prompts()}>عد إلى مكتبة البرومبتات</a>
      </p>
    </article>
  </div>
</Base>

<script define:vars={{ promptId: entry.id }}>
  window.__promptId = promptId;
</script>

<script>
  import { read, update } from '../../lib/progress';
  const id = (window as unknown as { __promptId: string }).__promptId;
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-fav]');

  function paint() {
    const s = read();
    const on = Boolean(s.favPrompts[id]);
    btns.forEach((b) => {
      b.setAttribute('aria-pressed', String(on));
      const l = b.querySelector<HTMLElement>('[data-fav-label]');
      if (l) l.textContent = on ? 'في المفضلة' : 'أضف إلى المفضلة';
    });
  }

  btns.forEach((b) =>
    b.addEventListener('click', () => {
      update((s) => {
        if (s.favPrompts[id]) delete s.favPrompts[id];
        else s.favPrompts[id] = Date.now();
      });
      paint();
    }),
  );

  paint();
</script>
